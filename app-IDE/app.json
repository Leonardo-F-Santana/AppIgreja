{
  "expo": {
    "name": "Ministério IDE",
    "slug": "projeto-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Img/logo.png",
    "scheme": "projetoexpo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Img/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/Img/logo_padded.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.leonardofsantana.projetoexpo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E2723",
          "image": "./assets/Img/logo.png",
          "imageWidth": 150
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec572129-260b-44fd-b598-a54466da7bf4"
      }
    }
  }
}
