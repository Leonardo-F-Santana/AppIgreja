rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------------------------
    // 1. Funções Auxiliares
    // ----------------------------------------------------------------------
    
    // Verifica se o utilizador está autenticado
    function isAuth() {
      return request.auth != null;
    }
    
    // Verifica se o utilizador tem privilégios de administrador.
    // Faz a leitura do documento do próprio utilizador na coleção 'users'.
    function isAdmin() {
      return isAuth() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // ----------------------------------------------------------------------
    // 2. Permissões por Coleção
    // ----------------------------------------------------------------------

    // Coleção: users (Utilizadores)
    // Continua PRIVADA: as regras do Firestore não filtram campos, portanto qualquer leitura
    // devolveria o documento inteiro (e-mail, telefone, role...). O login por username
    // usa a coleção 'usernames' abaixo.
    match /users/{userId} {
      // O utilizador pode ler os seus próprios dados. Admins podem ler todos.
      allow read: if isAuth() && request.auth.uid == userId;
      allow read: if isAdmin();
      
      // Criação:
      allow create: if isAuth() && request.auth.uid == userId && request.resource.data.role == 'membro';
      allow create: if isAdmin();
      
      // Atualização:
      allow update: if isAuth() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow update: if isAdmin();
      
      // Apenas admins podem apagar utilizadores.
      allow delete: if isAdmin();
    }

    // Coleção: usernames (lookup público para login por username)
    // Documento: usernames/{usernameLogin} → { uid, email }
    match /usernames/{handle} {
      // Leitura pontual pública (é preciso conhecer o handle exato) — necessária antes do login.
      allow get: if true;
      // Listagem proibida: impede enumerar utilizadores/e-mails.
      allow list: if false;

      // O próprio utilizador reserva o seu handle, apenas com { uid, email } que correspondam ao token.
      // Como 'update' é negado a não-admins, um handle já reservado não pode ser sequestrado.
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && (
          (request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email)
          || isAdmin()
        );

      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // Coleção: avisos
    match /avisos/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin(); // write engloba create, update e delete
    }

    // Coleção: eventos
    match /eventos/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Coleção: celulas
    match /celulas/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Coleção: visitantes
    match /visitantes/{document=**} {
      allow read: if isAuth();
      // Qualquer utilizador autenticado (inclusive anônimo) pode criar fichas de visitante (autoatendimento)
      allow create: if isAuth();
      // Apenas admins podem editar ou apagar fichas
      allow update, delete: if isAdmin();
    }

    // Coleção: transacoes
    match /transacoes/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Coleção: cultos
    match /cultos/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Coleção: doacoes
    match /doacoes/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Coleção: turmas (e subcoleções: alunos, aulas)
    match /turmas/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Coleção: configuracoes (meta de células, etc.)
    match /configuracoes/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Coleção: pedidos_oracao
    match /pedidos_oracao/{pedidoId} {
      // Qualquer utilizador autenticado pode criar um novo pedido de oração
      allow create: if isAuth();
      
      // O utilizador só pode ler os seus próprios pedidos (assume-se que guardamos o 'uid' no pedido).
      // Admins podem ler todos os pedidos de oração.
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      
      // O utilizador pode atualizar o seu próprio pedido (ex: editar o texto).
      // Admins podem atualizar todos os pedidos (ex: marcar como 'respondido').
      allow update: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      
      // Apenas administradores podem apagar pedidos.
      allow delete: if isAdmin();
    }

    // Coleção: devocionais
    match /devocionais/{document=**} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Coleção: logs_auditoria
    match /logs_auditoria/{document=**} {
      allow create: if isAuth();
      allow read: if isAdmin();
      allow update, delete: if false; // Logs são imutáveis
    }
  }
}
